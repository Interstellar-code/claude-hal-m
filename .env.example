# Copy to .env (plain docker compose) or paste into Dokploy's Environment tab.
# No real secrets here: fill in your own.

# Dashboard password, 8 or more characters (required).
MNEMOSYNE_UI_PASSWORD=change-me-to-a-long-password

# Tailscale auth key (Admin console -> Settings -> Keys), reusable or one-off,
# preferably with a tag such as tag:server so it does not expire with your account (required).
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXX
# Extra `tailscale up` flags, e.g. --advertise-tags=tag:server (optional).
TS_EXTRA_ARGS=

# The address shown in copied connection settings (optional; else the page's own origin).
MNEMOSYNE_PUBLIC_URL=https://mnemosyne.your-tailnet.ts.net
# Allowed Host header values, comma separated (optional; empty allows any).
MNEMOSYNE_HOSTS=

# Host folders. Keep them on a pool disk (/mnt/cache/...), not /mnt/user/... (SQLite WAL).
MNEMOSYNE_DATA=/mnt/cache/appdata/mnemosyne
TS_STATE=/mnt/cache/appdata/mnemosyne-tailscale

# Build options: 0 leaves the local embedding model out of the image.
MNEMOSYNE_BUILD_EMBEDDINGS=1
# The user that owns MNEMOSYNE_DATA on the host (Unraid: nobody:users = 99:100).
PUID=99
PGID=100
